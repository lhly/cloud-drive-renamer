{
  "manifest_version": 3,
  "default_locale": "zh_CN",
  "name": "__MSG_extName__",
  "version": "1.5.0",
  "description": "__MSG_extDescription__",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://pan.quark.cn/*",
    "https://www.aliyundrive.com/*",
    "https://www.alipan.com/*",
    "https://api.aliyundrive.com/*",
    "https://pan.baidu.com/*",
    "https://drive.uc.cn/*",
    "https://pan.uc.cn/*",
    "https://pc-api.uc.cn/*",
    "https://115.com/*",
    "https://webapi.115.com/*",
    "https://yun.123pan.cn/*",
    "https://yun.139.com/*",
    "https://personal-kd-njs.yun.139.com/*",
    "https://cloud.189.cn/*",
    "https://pan.xunlei.com/*",
    "https://api-pan.xunlei.com/*",
    "https://pc.woozooo.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pan.quark.cn/*"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pan.baidu.com/*"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.aliyundrive.com/*",
        "https://www.alipan.com/*"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://drive.uc.cn/*",
        "https://pan.uc.cn/*"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://115.com/*"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://yun.123pan.cn/*"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://yun.139.com/*"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cloud.189.cn/*"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pan.xunlei.com/*"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pc.woozooo.com/*"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "icons/*",
        "*.js",
        "*.css",
        "src/adapters/aliyun/page-script.js",
        "src/adapters/baidu/page-script.js",
        "src/adapters/quark/page-script.js",
        "src/adapters/uc/page-script.js",
        "src/adapters/115/page-script.js",
        "src/adapters/123/page-script.js",
        "src/adapters/cmcc/page-script.js",
        "src/adapters/esurfing/page-script.js",
        "src/adapters/xunlei/page-script.js",
        "src/adapters/woozooo/page-script.js"
      ],
      "matches": [
        "https://pan.quark.cn/*",
        "https://www.aliyundrive.com/*",
        "https://www.alipan.com/*",
        "https://pan.baidu.com/*",
        "https://drive.uc.cn/*",
        "https://pan.uc.cn/*",
        "https://115.com/*",
        "https://yun.123pan.cn/*",
        "https://yun.139.com/*",
        "https://cloud.189.cn/*",
        "https://pan.xunlei.com/*",
        "https://pc.woozooo.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
