{
  "name": "cloud-drive-renamer",
  "version": "1.5.0",
  "description": "云盘文件批量重命名工具，支持 115 网盘、123 云盘、阿里云盘、百度网盘、移动云盘、天翼云盘、夸克网盘、UC 网盘",
  "type": "module",
  "scripts": {
    "dev": "pnpm run sync:version && vite",
    "build": "pnpm run sync:version && pnpm run lint && pnpm run typecheck && pnpm run test:ci && tsc && vite build",
    "preview": "vite preview",
    "sync:version": "node scripts/sync-version.js",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run test:ci",
    "ci": "pnpm run validate && pnpm run build",
    "resize": "node scripts/resize-screenshots.js",
    "verify:release": "node scripts/verify-release.js"
  },
  "keywords": [
    "chrome-extension",
    "rename",
    "batch-rename",
    "cloud-drive",
    "115",
    "123pan",
    "aliyun",
    "baidu",
    "cmcc",
    "esurfing",
    "quark",
    "uc"
  ],
  "author": "CloudDrive Renamer Team",
  "license": "MIT",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.3.0",
    "@playwright/test": "^1.57.0",
    "@types/chrome": "^0.0.260",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8.57.1",
    "jsdom": "^27.3.0",
    "prettier": "^3.7.4",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@lit-labs/virtualizer": "^2.1.1",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "lit": "^3.3.1"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
